@{
    // Sin layout a propósito: esta página la guarda el service worker y la muestra cuando no hay red
    // (RF-26, AC-40). Al no depender del layout, la copia guardada es idéntica para cualquiera —no
    // incluye el nombre de la cuenta ni el menú de sesión— y no necesita que la hoja de estilos esté
    // en la caché para verse bien.
    Layout = null;
    ViewData["Title"] = "Sin conexión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sin conexión - Mi Archivo Médico</title>
    <meta name="theme-color" content="#0d5a6a" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: #1b2a2e;
            background-color: #f4f7f8;
        }

        main {
            max-width: 26rem;
            text-align: center;
        }

        .marca {
            width: 4rem;
            height: 4rem;
            margin: 0 auto 1.25rem;
        }

        h1 {
            font-size: 1.5rem;
            margin: 0 0 0.75rem;
        }

        p {
            margin: 0 0 1.5rem;
            line-height: 1.5;
        }

        button {
            font: inherit;
            padding: 0.6rem 1.4rem;
            border: 0;
            border-radius: 0.4rem;
            color: #fff;
            background-color: #0d5a6a;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <main>
        <img class="marca" src="/iconos/icono-192.png" alt="" />
        <h1>Sin conexión</h1>
        <p>
            No hay conexión a internet, así que no se puede mostrar esta pantalla.
            Tus estudios siguen guardados en el servidor: volvé a intentarlo cuando la conexión se
            restablezca.
        </p>
        <button type="button" onclick="location.reload()">Reintentar</button>
    </main>
</body>
</html>
