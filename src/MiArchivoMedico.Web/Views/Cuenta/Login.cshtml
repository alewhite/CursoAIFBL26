@model MiArchivoMedico.Web.Models.InicioDeSesionViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-6 col-lg-4">
        <h1 class="h3 mb-4">Iniciar sesión</h1>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="NombreDeUsuario" class="form-label"></label>
                <input asp-for="NombreDeUsuario" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="NombreDeUsuario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>

        @* El alta y el restablecimiento de contraseña son administrativos, fuera de la aplicación (RNF-54). *@
        <p class="text-muted small mt-3 mb-0">
            Las cuentas se dan de alta y se restablecen fuera de la aplicación.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
