@model IReadOnlyCollection<MiArchivoMedico.Web.Dominio.Estudio>
@{
    ViewData["Titulo"] = "Mis estudios";
}
<h1>Mis estudios</h1>

@if (Model.Count == 0)
{
    <div class="tarjeta">
        <p>Todavía no cargaste ningún estudio.</p>
    </div>
}
else
{
    <div class="desplazable">
        <table>
            <thead>
                <tr><th>Fecha</th><th>Título</th><th>Institución</th></tr>
            </thead>
            <tbody>
            @foreach (var estudio in Model)
            {
                <tr>
                    <td>@estudio.Fecha.ToString("dd/MM/yyyy")</td>
                    <td><a asp-action="Detalle" asp-route-id="@estudio.Id">@estudio.Titulo</a></td>
                    <td>@estudio.Institucion</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
