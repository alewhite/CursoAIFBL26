@model MiArchivoMedico.Web.Models.EstudioFormularioViewModel
@{
    ViewData["Title"] = "Editar estudio";
}

<h1 class="h3 mb-4">Editar estudio</h1>

<form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_Formulario" model="Model" />

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
