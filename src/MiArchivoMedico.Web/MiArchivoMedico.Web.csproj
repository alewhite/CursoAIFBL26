<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiArchivoMedico.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistencia SQLite (NFR-04) y modelo de cuentas de ASP.NET Core Identity (NFR-01).
         Prohibido Microsoft.AspNetCore.Identity.UI: publica /Identity/Account/Register,
         /ForgotPassword y /Manage/* sin escribir una línea, y violaría FR-01 y AC-02. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
