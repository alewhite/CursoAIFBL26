# BEGIN DAW — pipeline runtime, NOT committed (managed by DAW)
#   .daw-state.json  = which phase you are in; yours, not the repo's
#   .daw-paused/     = paused tickets
#   .daw-sessions/   = live session markers
#   .daw-journal.jsonl = transitions that landed; outlives the state file
.daw-state.json
.daw-paused/
.daw-sessions/
.daw-journal.jsonl
# END DAW

# Artefactos de compilación de .NET
bin/
obj/

# Bases de datos SQLite y sus archivos auxiliares: nunca se versionan (NFR-04).
*.db
*.db-wal
*.db-shm

# Configuración local con secretos: nunca se versiona.
appsettings.*.local.json

# Resultados de tests y cobertura
TestResults/

# Artefactos de tooling en Python (scripts de DAW)
__pycache__/
*.pyc
